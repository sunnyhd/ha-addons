#!/command/with-contenv bash
# One player per zone, all in this container.
#
# The port is the reason this lives here and not in five add-ons: the player
# listens on one, and five containers on the host's network can only fight over
# the same one. In a single container it is a count -- sendspin-cli takes a
# --port, and its help names exactly this case.
set -uo pipefail

source /usr/lib/bashio/bashio.sh
source /usr/lib/zone-players/common.sh

declare -a ZONE_NAME ZONE_OUTPUT ZONE_PID
ZONE_COUNT=0

# ------------------------------------------------------------------------------
# Configuration
# ------------------------------------------------------------------------------
read_config() {
    local config i count

    # Not via bashio::config, but the whole configuration once and then jq:
    # bashio::config cannot tell the JSON null of an unset option from the string
    # "null" and returns the word "null" for an empty master_sink -- read as a
    # sink name that is an output which does not exist. `// empty` makes the
    # distinction. One fetch, so an unreachable Supervisor ends here rather than
    # letting every value fall through to its default individually.
    config=$(bashio::addon.config) \
        || bashio::exit.nok 'The add-on options cannot be read from the Supervisor.'

    SERVER=$(jq -r '.server // empty' <<< "${config}")
    MASTER=$(jq -r '.master_sink // empty' <<< "${config}")
    LOG_LEVEL=$(jq -r '.log_level // "info"' <<< "${config}")
    BUFFER_MS=$(jq -r '.buffer_ms // empty' <<< "${config}")

    count=$(jq -r '.zones | length' <<< "${config}")
    for ((i = 0; i < count; i++)); do
        ZONE_NAME[i]=$(jq -r --argjson i "${i}" '.zones[$i].name // empty' <<< "${config}")
        ZONE_OUTPUT[i]=$(jq -r --argjson i "${i}" '.zones[$i].output // empty' <<< "${config}")
        if [ -z "${ZONE_NAME[i]}" ] || [ -z "${ZONE_OUTPUT[i]}" ]; then
            bashio::exit.nok "Zone $((i + 1)) has no name or no output."
        fi
    done
    ZONE_COUNT=${count}

    if [ "${ZONE_COUNT}" -eq 0 ]; then
        bashio::exit.nok 'No zone is configured -- without at least one there is nothing to play.'
    fi

    # Without the host's network a player cannot advertise over mDNS and the
    # server cannot connect back. It dials out instead, and for that it has to
    # know where to.
    if [ -z "${SERVER}" ]; then
        bashio::exit.nok 'The Music Assistant server address is missing (field "Music Assistant server", e.g. 192.168.1.10:8927).'
    fi

    # A newline in a value would write configuration keys of the caller's choosing
    # into the rendered file. The values themselves are checked.
    local value
    for value in "${SERVER}" "${MASTER}" "${LOG_LEVEL}" "${BUFFER_MS}" \
        "${ZONE_NAME[@]}" "${ZONE_OUTPUT[@]}"; do
        if [ "${value}" != "${value%%$'\n'*}" ]; then
            bashio::exit.nok 'A configuration value contains a newline.'
        fi
    done
}

# ------------------------------------------------------------------------------
# Sinks
# ------------------------------------------------------------------------------
setup_sinks() {
    local map available

    if [ -z "${MASTER}" ]; then
        MASTER=$(zone::detect_master)
        if [ -z "${MASTER}" ]; then
            bashio::exit.nok 'No multi-channel output found. Is the card profile set to surround? Otherwise enter the sink in the "Master sink" field.'
        fi
        zone::log "Multi-channel output detected: ${MASTER}"
    fi

    map=$(zone::channel_map "${MASTER}")
    if [ -z "${map}" ]; then
        bashio::exit.nok "The output ${MASTER} is not known to PulseAudio."
    fi
    zone::log "Channel map: ${map}"

    zone::ensure_sinks "${MASTER}" "${map}"

    # What is actually there in the end -- a zone pointing at a sink this device
    # does not provide should say so at startup rather than land silently on the
    # default output.
    available=$(zone::available_zones "${map}" | cut -d' ' -f1)
    local i
    for ((i = 0; i < ZONE_COUNT; i++)); do
        if ! printf '%s\n' "${available}" | grep -qx "${ZONE_OUTPUT[i]}"; then
            zone::log "Zone \"${ZONE_NAME[i]}\" is set to ${ZONE_OUTPUT[i]}, which this output does not have."
            zone::log "Available are: $(printf '%s' "${available}" | tr '\n' ' ')"
            bashio::exit.nok 'Please set the zone to an existing output pair.'
        fi
    done
}

# ------------------------------------------------------------------------------
# Players
# ------------------------------------------------------------------------------
start_zone() {
    local i=$1
    local id port conf state sock

    id="$(zone::instance_id)-z$((i + 1))"
    port=$((BASE_PORT + i))
    state="${STATE_ROOT}/z$((i + 1))"
    sock="${RUN_DIR}/z$((i + 1)).sock"
    conf="${RUN_DIR}/z$((i + 1)).conf"

    mkdir -p "${state}" "${RUN_DIR}"
    # The server value can carry credentials, and this file is the first thing
    # pasted into a support thread.
    install -m 600 /dev/null "${conf}"
    {
        printf 'name = %s\n' "${ZONE_NAME[i]}"
        printf 'output = pulse:%s\n' "${ZONE_OUTPUT[i]}"
        printf 'log-level = %s\n' "${LOG_LEVEL}"
        printf 'server = %s\n' "${SERVER}"
        printf 'id = %s\n' "${id}"
        printf 'manufacturer = %s\n' 'Music Assistant'
        printf 'product-name = %s\n' 'Local Audio'
        if [ -n "${BUFFER_MS}" ]; then
            printf 'buffer-ms = %s\n' "${BUFFER_MS}"
        fi
    } > "${conf}"

    sendspin-cli --config "${conf}" --state-dir "${state}" \
        --control-socket "${sock}" --port "${port}" &
    ZONE_PID[i]=$!
    zone::log "Zone \"${ZONE_NAME[i]}\" on ${ZONE_OUTPUT[i]}, port ${port}, id ${id} (pid ${ZONE_PID[i]})"
}

stop_all() {
    local i
    for ((i = 0; i < ZONE_COUNT; i++)); do
        [ -n "${ZONE_PID[i]:-}" ] && kill "${ZONE_PID[i]}" 2> /dev/null
    done
    wait
    exit 0
}

# ------------------------------------------------------------------------------
main() {
    trap stop_all TERM INT

    read_config
    zone::wait_for_pulse || bashio::exit.nok 'PulseAudio is not reachable.'
    setup_sinks

    local i
    for ((i = 0; i < ZONE_COUNT; i++)); do
        start_zone "${i}"
    done

    # The loop keeps two things alive. A player that ends it restarts -- unlike
    # the original, where a failure stops the container, because here four other
    # zones hang off it that are not at fault. And it notices when the sinks have
    # disappeared: a restart of the audio plugin takes them with it, and without
    # them every player plays into the void.
    local tick=0
    while :; do
        sleep 5
        for ((i = 0; i < ZONE_COUNT; i++)); do
            if ! kill -0 "${ZONE_PID[i]}" 2> /dev/null; then
                zone::log "Zone \"${ZONE_NAME[i]}\" has ended, restarting it."
                start_zone "${i}"
            fi
        done

        tick=$((tick + 1))
        if [ $((tick % 6)) -eq 0 ]; then
            if [ -S "${PULSE_SOCKET}" ]; then
                local map
                map=$(zone::channel_map "${MASTER}")
                [ -n "${map}" ] && zone::ensure_sinks "${MASTER}" "${map}"
            fi
        fi
    done
}

main "$@"
